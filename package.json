{
  "name": "omniwebhook-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter omniwebhook build",
    "lint": "pnpm --filter omniwebhook lint",
    "typecheck": "pnpm --filter omniwebhook typecheck",
    "test": "pnpm --filter omniwebhook test",
    "test:architecture": "pnpm --filter omniwebhook test:architecture",
    "check:package": "pnpm --filter omniwebhook check:package",
    "check:spec": "python3 tools/gen_vectors.py --check",
    "check": "pnpm check:spec && pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm test && pnpm check:package",
    "test:integration": "pnpm --filter omniwebhook test:integration",
    "test:runtime": "pnpm --filter omniwebhook test:runtime",
    "test:interop": "pnpm build && python3 tools/interop.py",
    "check:docs": "python3 tools/check_docs.py"
  }
}

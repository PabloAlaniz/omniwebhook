{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PabloAlaniz/omniwebhook/spec/schemas/vector.schema.json",
  "title": "Vector de conformidad de omniwebhook",
  "type": "object",
  "required": [
    "spec",
    "id",
    "kind",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "kind": {
      "enum": [
        "verify",
        "sign",
        "store",
        "receive",
        "response",
        "address",
        "url",
        "network",
        "delivery-class",
        "retry"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

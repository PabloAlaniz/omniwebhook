  {
   "name": "reservar, completar y volver a pedir",
   "steps": [
    {
     "op": "claim",
     "key": "standard:msg_1",
     "token": "a",
     "now": 1700000000,
     "lease_seconds": 300,
     "expected": "claimed"
    },
    {
     "op": "complete",
     "key": "standard:msg_1",
     "token": "a",
     "now": 1700000001,
     "retention_seconds": 604800,
     "expected": true
    },
    {
     "op": "claim",
     "key": "standard:msg_1",
     "token": "b",
     "now": 1700000002,
     "lease_seconds": 300,
     "expected": "duplicate"
    }
   ]
  },
  {

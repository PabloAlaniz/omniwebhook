{
 "spec": "0",
 "id": "entregar/bandeja",
 "kind": "outbox",
 "cases": [
  {
   "name": "lo encolado se toma y, entregado, no vuelve a salir",
   "steps": [
    {
     "op": "enqueue",
     "message_id": "msg_1",
     "endpoint_id": "ep_1",
     "payload": "{\"n\":\"msg_1\"}",
     "now": 1700000000,
     "expected": true
    },
    {
     "op": "claim",
     "token": "d-1",
     "now": 1700000000,
     "limit": 10,
     "lease_seconds": 300,
     "expected": [
      {
       "message_id": "msg_1",
       "endpoint_id": "ep_1",
       "payload": "{\"n\":\"msg_1\"}",
       "attempt": 1
      }
     ]
    },
    {
     "op": "settle",
     "message_id": "msg_1",
     "endpoint_id": "ep_1",
     "token": "d-1",
     "state": "delivered",
     "expected": true
    },
    {
     "op": "claim",
     "token": "d-2",
     "now": 1700001000,
     "limit": 10,
     "lease_seconds": 300,
     "expected": []
    }
   ]
  },
  {
   "name": "sin nada encolado no hay nada que tomar",
   "steps": [
    {
     "op": "claim",
     "token": "d-1",
     "now": 1700000000,
     "limit": 10,
     "lease_seconds": 300,
     "expected": []
    }
   ]
  },

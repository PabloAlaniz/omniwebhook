{
  "name": "omniwebhook",
  "version": "0.4.0",
  "description": "Webhooks firmados que se emiten y se reciben igual en cualquier stack: verificación, frescura, idempotencia y reintentos con las mismas reglas.",
  "license": "MIT",
  "author": "Pablo Alaniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloAlaniz/omniwebhook.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/PabloAlaniz/omniwebhook#readme",
  "bugs": "https://github.com/PabloAlaniz/omniwebhook/issues",
  "keywords": [
    "webhooks",
    "webhook",
    "signature",
    "hmac",
    "idempotency",
    "retries",
    "standard-webhooks",
    "mercadopago",
    "tiktok",
    "slack",
    "shopify"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "omniwebhook": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./standard": {
      "import": {
        "types": "./dist/standard.d.ts",
        "default": "./dist/standard.js"
      },
      "require": {
        "types": "./dist/standard.d.cts",
        "default": "./dist/standard.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "check:package": "pnpm build && publint --strict && attw --pack . --profile node16",
    "prepack": "cp ../LICENSE ./LICENSE && pnpm build",
    "postpack": "rm -f LICENSE",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:runtime": "pnpm build && node test/runtime/smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "fast-check": "^4.11.0",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "redis": "^6.4.0",
    "standardwebhooks": "^1.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "standardwebhooks": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "standardwebhooks": {
      "optional": true
    }
  }
}
